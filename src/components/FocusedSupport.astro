---
import type { SectionProps } from '../types';

export type Props = SectionProps;

const { id = "support", className = '' } = Astro.props satisfies SectionProps;

const services = [
  "HubSpot CMS themes, templates, and reusable modules",
  "HubSpot UI extensions with React and TypeScript",
  "HubSpot API integrations, serverless functions, and internal tools",
  "Frontend implementation for focused product or marketing workflows",
];
---

<section id={id} class={`max-w-2xl mx-auto px-6 pb-20 ${className}`}>
  <h2 class="text-sm font-semibold mb-6">focused support</h2>
  <div class="space-y-4 text-sm leading-relaxed text-zinc-300">
    <p>
      I occasionally take on scoped remote HubSpot CMS and frontend work when the problem is a good fit for my background.
    </p>
    <ul class="grid gap-2 text-zinc-400">
      {services.map((service) => (
        <li class="flex gap-3">
          <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-zinc-500"></span>
          <span>{service}</span>
        </li>
      ))}
    </ul>
    <p>
      Best fit: defined build, migration, module, integration, or technical support work for remote-friendly teams where senior HubSpot CMS execution matters more than a large delivery team.
    </p>
  </div>
</section>
