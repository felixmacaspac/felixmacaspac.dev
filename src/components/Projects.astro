---
import { projects } from '../../data/projects';
import type { SectionProps } from '../types';
import ProjectCard from './ProjectCard.astro';

export type Props = SectionProps;

const { id = 'projects', className = '' } = Astro.props satisfies SectionProps;
---

<section id={id} aria-labelledby="selected-projects-heading" class={`max-w-2xl mx-auto px-6 pb-20 ${className}`}>
  <div class="mb-8 flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="selected-projects-heading" class="text-sm font-semibold">selected projects</h2>
    <a href="/hubspot/" class="text-sm text-zinc-300 underline underline-offset-4 transition-colors hover:text-white">HubSpot portfolio &rarr;</a>
  </div>
  <div class="space-y-12">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</section>
