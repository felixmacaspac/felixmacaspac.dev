---
import type { Activity, SectionProps } from '../types';
import { activities as defaultActivities } from '../../data/activities';

type Props = SectionProps & {
  activities?: Activity[];
};

const { id = 'activities', className = '', activities = defaultActivities } = Astro.props satisfies Props;

const typeStyles: Record<Activity['type'], string> = {
  speaking: 'bg-blue-900/30 text-blue-300 border-blue-800/50',
  competition: 'bg-amber-900/30 text-amber-300 border-amber-800/50',
  community: 'bg-green-900/30 text-green-300 border-green-800/50',
  certification: 'bg-purple-900/30 text-purple-300 border-purple-800/50',
  achievement: 'bg-red-900/30 text-red-300 border-red-800/50',
};
---

<section id={id} aria-labelledby="activities-heading" class={`max-w-2xl mx-auto px-6 pb-20 ${className}`}>
  <h2 id="activities-heading" class="mb-8 text-sm font-semibold">activities &amp; achievements</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    {activities.map((activity) => (
      <article class="rounded-xl border border-zinc-800 bg-zinc-950 p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class={`rounded-full border px-2.5 py-1 text-xs font-medium ${typeStyles[activity.type]}`}>{activity.type}</span>
          {activity.date && <span class="text-xs text-zinc-400">{activity.date}</span>}
        </div>
        <h3 class="mt-4 text-sm font-semibold">{activity.title}</h3>
        {activity.organization && <p class="mt-1 text-xs text-zinc-300">{activity.organization}</p>}
        <p class="mt-3 text-xs leading-relaxed text-zinc-400">{activity.description}</p>
        {activity.link && <a href={activity.link} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-xs underline underline-offset-4 hover:text-zinc-300">View details &nearr;</a>}
      </article>
    ))}
  </div>
</section>
